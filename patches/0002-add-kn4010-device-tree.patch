diff --git a/target/linux/mediatek/dts/mt7981b-keenetic-kn-4010.dts b/target/linux/mediatek/dts/mt7981b-keenetic-kn-4010.dts
new file mode 100644
index 0000000..471e62b
--- /dev/null
+++ b/target/linux/mediatek/dts/mt7981b-keenetic-kn-4010.dts
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/dts-v1/;
+
+#include "mt7981b.dtsi"
+
+/ {
+	model = "Keenetic KN-4010";
+	compatible = "keenetic,kn-4010", "mediatek,mt7981";
+
+	aliases {
+		label-mac-device = &gmac1;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * The stock layout has two independent firmware regions.  OpenWrt owns
+	 * only the first one: firmware_2 remains an untouched KeeneticOS recovery
+	 * slot.  In particular, do not make a concat device from both slots: an
+	 * ordinary sysupgrade must never span into the recovery image.
+	 */
+	virtual_flash {
+		compatible = "mtd-concat";
+		devices = <&firmware1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "kernel";
+				reg = <0x0 0x600000>;
+			};
+
+			partition@600000 {
+				label = "ubi";
+				reg = <0x600000 0x3100000>;
+			};
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&watchdog {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio_pins>;
+
+	gmac0: mac@0 {
+		compatible = "mediatek,eth-mac";
+		reg = <0>;
+		phy-mode = "sgmii";
+		phy-handle = <&en8801s>;
+		managed = "in-band-status";
+		label = "lan";
+		nvmem-cells = <&macaddr_factory_4>;
+		nvmem-cell-names = "mac-address";
+	};
+
+	gmac1: mac@1 {
+		compatible = "mediatek,eth-mac";
+		reg = <1>;
+		phy-mode = "gmii";
+		phy-handle = <&int_gbe_phy>;
+		label = "wan";
+		nvmem-cells = <&macaddr_factory_a>;
+		nvmem-cell-names = "mac-address";
+	};
+};
+
+&mdio_bus {
+		en8801s: ethernet-phy@1d {
+		compatible = "ethernet-phy-id03a2.9471";
+			reg = <0x1d>;
+		phy-mode = "sgmii";
+			airoha,surge = <1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&gbe_int_pins>;
+		interrupt-parent = <&pio>;
+		interrupts = <38 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+&pio {
+	spi0_flash_pins: spi0-pins {
+		mux {
+			function = "spi";
+			groups = "spi0", "spi0_wp_hold";
+		};
+
+		conf-pu {
+			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
+			drive-strength = <MTK_DRIVE_8mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
+		};
+
+		conf-pd {
+			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
+			drive-strength = <MTK_DRIVE_8mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
+		};
+	};
+
+	/* Stock DTB enables a pull-up on GBE_INT (GPIO38). */
+	gbe_int_pins: gbe-int-pins {
+		conf-pu {
+			pins = "GBE_INT";
+			mediatek,pull-up-adv = <2>;
+		};
+	};
+};
+
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_flash_pins>;
+	status = "okay";
+
+	/* Winbond W25N01GV, 128 MiB SPI-NAND */
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+		mediatek,nmbm;
+		mediatek,bmt-max-ratio = <1>;
+		mediatek,bmt-max-reserved-blocks = <256>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 { label = "preloader"; reg = <0x0 0x80000>; read-only; };
+			partition@80000 { label = "u-boot"; reg = <0x80000 0x200000>; read-only; };
+			partition@280000 { label = "u-config"; reg = <0x280000 0x80000>; read-only; };
+
+			partition@300000 {
+				label = "rf-eeprom";
+				reg = <0x300000 0x200000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+					eeprom_factory: eeprom@0 { reg = <0x0 0x1000>; };
+					macaddr_factory_4: macaddr@4 { reg = <0x4 0x6>; };
+					macaddr_factory_a: macaddr@a { reg = <0xa 0x6>; };
+				};
+			};
+
+			firmware1: partition@500000 { label = "firmware_1"; reg = <0x500000 0x3700000>; };
+			partition@3c00000 { label = "u-state"; reg = <0x3c00000 0x80000>; read-only; };
+			partition@3c80000 { label = "reserved"; reg = <0x3c80000 0x200000>; read-only; };
+			partition@3e80000 { label = "u-config-res"; reg = <0x3e80000 0x80000>; read-only; };
+			partition@3f00000 { label = "rf-eeprom-res"; reg = <0x3f00000 0x200000>; read-only; };
+			firmware2: partition@4100000 { label = "firmware_2"; reg = <0x4100000 0x3700000>; };
+		};
+	};
+};
+
+&wifi {
+	nvmem-cells = <&eeprom_factory>;
+	nvmem-cell-names = "eeprom";
+	status = "okay";
+};
