diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 347169c..9c07276 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -2238,7 +2238,7 @@ define Device/keenetic_kn-3911
   DEVICE_MODEL := KN-3911
   DEVICE_DTS := mt7981b-keenetic-kn-3911
   DEVICE_DTS_DIR := ../dts
-  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware kmod-phy-airoha-en8811h
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware
   UBINIZE_OPTS := -E 5
   BLOCKSIZE := 128k
   PAGESIZE := 2048
@@ -2253,6 +2253,27 @@ define Device/keenetic_kn-3911
 endef
 TARGET_DEVICES += keenetic_kn-3911
 
+define Device/keenetic_kn-4010
+  DEVICE_VENDOR := Keenetic
+  DEVICE_MODEL := Racer KN-4010
+  DEVICE_DTS := mt7981b-keenetic-kn-4010
+  DEVICE_DTS_DIR := ../dts
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware
+  UBINIZE_OPTS := -E 5
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  KERNEL_SIZE := 6144k
+  # One 55 MiB firmware slot. firmware_2 stays stock for recovery.
+  IMAGE_SIZE := 56320k
+  KERNEL := kernel-bin | lzma | fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb | append-squashfs4-fakeroot
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+  IMAGES += raw-slot.bin
+  # Raw, unwrapped image for direct placement at the start of firmware_1.
+  # Do not use the Keenetic web-UI header here: U-Boot expects a FIT at byte 0.
+  IMAGE/raw-slot.bin := append-kernel | pad-to $$(KERNEL_SIZE) | append-ubi | check-size
+endef
+TARGET_DEVICES += keenetic_kn-4010
+
 define Device/konka_komi-a31
   DEVICE_VENDOR := Konka
   DEVICE_MODEL := KOMI A31
