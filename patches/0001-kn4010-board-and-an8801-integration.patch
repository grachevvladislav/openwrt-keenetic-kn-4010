diff --git a/target/linux/mediatek/files/drivers/net/phy/en8801sc.c b/target/linux/mediatek/files/drivers/net/phy/en8801sc.c
index 08774e3..79a2a63 100644
--- a/target/linux/mediatek/files/drivers/net/phy/en8801sc.c
+++ b/target/linux/mediatek/files/drivers/net/phy/en8801sc.c
@@ -448,17 +448,23 @@ static int en8801s_phase1_init(struct phy_device *phydev)
 	priv->count = 1;
 	msleep(1000);
 
-	retry = MAX_OUI_CHECK;
+	/* Some boards expose the PBUS window at the PHY address itself. */
+	retry = MAX_OUI_CHECK + 1;
 	while (1) {
 		pbus_data = airoha_pbus_read(mbus, pbus_addr,
 				EN8801S_RG_ETHER_PHY_OUI);      /* PHY OUI */
+		dev_info(dev, "PBUS probe: MDIO 0x%x, PBUS 0x%x, OUI 0x%lx\n",
+			 phydev->mdio.addr, pbus_addr, pbus_data);
 		if (pbus_data == EN8801S_PBUS_OUI) {
 			dev_info(dev, "PBUS addr 0x%x: Start initialized.\n",
 					pbus_addr);
 			break;
 		}
-		pbus_addr = phydev_pbus_addr(phydev);
-		if (0 == --retry) {
+		if (--retry == 2)
+			pbus_addr = phydev_pbus_addr(phydev);
+		else if (retry == 1)
+			pbus_addr = phydev_phy_addr(phydev);
+		else if (retry == 0) {
 			dev_err(dev, "Probe fail !\n");
 			return 0;
 		}
